BINANCE_API_KEY=changeme
BINANCE_API_SECRET=changeme

TESTNET=true
OPENROUTER_API_KEY=
# Ordered best-to-worst free OpenRouter fallback chain for portfolio JSON advice.
# Separate with comma, semicolon, or newline. There is no hard model-count limit.
OPENROUTER_MODELS=openrouter/owl-alpha,nvidia/nemotron-3-super-120b-a12b:free,deepseek/deepseek-v4-flash:free,qwen/qwen3-next-80b-a3b-instruct:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,openai/gpt-oss-120b:free,nousresearch/hermes-3-llama-3.1-405b:free,meta-llama/llama-3.3-70b-instruct:free,z-ai/glm-4.5-air:free,arcee-ai/trinity-large-thinking:free,minimax/minimax-m2.5:free,nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-nano-9b-v2:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-nano-12b-v2-vl:free,poolside/laguna-m.1:free,poolside/laguna-xs.2:free,baidu/cobuddy:free,openai/gpt-oss-20b:free,liquid/lfm-2.5-1.2b-thinking:free,liquid/lfm-2.5-1.2b-instruct:free,meta-llama/llama-3.2-3b-instruct:free,openrouter/free
OPENROUTER_MODELS_REGISTRY=state/openrouter_models.json
# Set OPENROUTER_MODELS_MODE=manual to ignore the auto-curated registry and force OPENROUTER_MODELS.
OPENROUTER_MODELS_MODE=auto
# Deprecated compatibility inputs. Used only when OPENROUTER_MODELS is absent.
MODEL_NAME=
MODEL_FALLBACK=
MODEL_SECOND_FALLBACK=

DEFAULT_DRY_RUN=true
DEFAULT_PROFILE=moderate
DEFAULT_DRIFT=0.10
DEFAULT_MAX_SLIPPAGE=0.003
DEFAULT_MIN_NOTIONAL=10
DEFAULT_QUOTE=USDT

BUCKETS_JSON={"stable":["USDT"],"alt":["BNB","AVAX","ADA"]}
PROFILE_TARGETS_MODERATE=BTC=0.40,ETH=0.20,SOL=0.15,STABLE=0.15,ALT=0.10
PROFILE_TARGETS_AGGRESSIVE=BTC=0.30,ETH=0.25,SOL=0.20,ALT=0.15,STABLE=0.10
PROFILE_TARGETS_CONSERVATIVE=BTC=0.35,ETH=0.15,SOL=0.05,ALT=0.05,STABLE=0.40

STABLE_ASSETS=USDT,USDC,BUSD,TUSD,FDUSD,DAI
STABLE_GUARDRAIL=0.10
BTC_GUARDRAIL=0.25
LOG_RETENTION_DAYS=14

SIMPLE_EARN_ENABLED=false
SIMPLE_EARN_FAST_REDEEM=true
SIMPLE_EARN_EXCLUDE_ASSETS=
